{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch",
    ":automergeDigest",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes",
    ":enableVulnerabilityAlerts",
    "github>derteaser/renovate-presets:gitmoji"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "schedule": ["at any time"]
    },
    {
      "matchPackageNames": ["pnpm"],
      "minor": {
        "automerge": true
      },
      "patch": {
        "automerge": true
      },
      "pin": {
        "automerge": true
      }
    },
    {
      "matchSourceUrls": ["https://github.com/alpinejs/alpine{/,}**"],
      "groupName": "AlpineJS monorepo",
      "groupSlug": "alpinejs"
    }
  ]
}
